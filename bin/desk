#!/usr/bin/env python3
"""desk — the orchestrator's channel to the owner: ask questions, read answers, close them."""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from desk import asks  # noqa: E402

EPILOG = """примеры:
  desk ask --task MER-3552 --question "Выпускать ли conn v0.17.0?" \\
      --context-file ctx.md --option "A=Выпустить сразу :: notifier обновит conn сегодня" \\
      --option "B=Сначала ctxval :: релиз на день позже" --recommend A --why "изменение маленькое" \\
      --link https://github.com/MercuryoPro/go-libs/pull/170
  desk answers          # новые ответы владельца (и отметить их прочитанными)
  desk done ask-7 --note "смержил #170, тег conn/v0.17.0"
  desk withdraw ask-7 --note "вопрос снят: ..."
"""


def parse_option(raw):
    key, sep, rest = raw.partition("=")
    if not sep or not key.strip():
        raise SystemExit(f"--option должен быть вида 'A=подпись :: последствия', а не {raw!r}")
    label, _, effect = rest.partition("::")
    return {"key": key.strip(), "label": label.strip(), "effect": effect.strip()}


def main():
    ap = argparse.ArgumentParser(prog="desk", description=__doc__, epilog=EPILOG,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("ask", help="задать вопрос владельцу")
    a.add_argument("--task", help="задача, к которой относится вопрос (MER-123); без неё — общий вопрос")
    a.add_argument("--question", required=True, help="вопрос одной строкой")
    a.add_argument("--context", default="", help="контекст в markdown")
    a.add_argument("--context-file", help="контекст из файла (markdown); '-' — из stdin")
    a.add_argument("--option", action="append", default=[], help="'A=подпись :: последствия', можно несколько")
    a.add_argument("--recommend", help="ключ рекомендуемого варианта")
    a.add_argument("--why", default="", help="почему рекомендуешь")
    a.add_argument("--link", action="append", default=[], help="ссылка на PR/задачу или полный путь к файлу")
    a.add_argument("--orchestrator", default=os.environ.get("DESK_ORCHESTRATOR", "orchestrator/developer"))

    sub.add_parser("asks", help="открытые и отвеченные вопросы")
    r = sub.add_parser("answers", help="новые ответы владельца")
    r.add_argument("--peek", action="store_true", help="не отмечать прочитанными")
    d = sub.add_parser("done", help="ответ выполнен")
    d.add_argument("id")
    d.add_argument("--note", default="")
    w = sub.add_parser("withdraw", help="вопрос больше не нужен")
    w.add_argument("id")
    w.add_argument("--note", default="")
    s = sub.add_parser("show", help="показать вопрос целиком")
    s.add_argument("id")

    args = ap.parse_args()
    try:
        if args.cmd == "ask":
            context = args.context
            if args.context_file:
                context = sys.stdin.read() if args.context_file == "-" else open(args.context_file, encoding="utf-8").read()
            ask = asks.create(args.question, task=args.task, context=context,
                              options=[parse_option(o) for o in args.option], recommend=args.recommend,
                              why=args.why, links=args.link, orchestrator=args.orchestrator)
            print(f"{ask['id']} создан: {ask['question']}")
        elif args.cmd == "asks":
            for q in asks.all_asks():
                if q["status"] in ("open", "answered"):
                    print(f"{q['id']:8} {q['status']:9} {q.get('task') or '—':10} {q['question']}")
        elif args.cmd == "answers":
            pending = asks.pending_answers()
            if not pending:
                print("новых ответов нет")
            for q in pending:
                print(asks.render_answer(q))
                print()
                if not args.peek:
                    asks.consume(q["id"])
        elif args.cmd == "done":
            print(f"{asks.done(args.id, args.note)['id']} выполнен")
        elif args.cmd == "withdraw":
            print(f"{asks.withdraw(args.id, args.note)['id']} снят")
        elif args.cmd == "show":
            import json
            print(json.dumps(asks.get(args.id), ensure_ascii=False, indent=1))
    except ValueError as e:
        raise SystemExit(f"desk: {e}")


if __name__ == "__main__":
    main()
